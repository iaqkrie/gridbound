{
  "schemaVersion": 2,
  "id": "classic-colony",
  "name": "Classic Colony",
  "description": "Food, Wood, Stone, Population, and Moisture.",
  "author": "iaqkrie & Gemini 4 Neon",
  "defaultGridSize": { "width": 32, "height": 24 },
  "defaultCellTypeId": "empty",
  "initialCycles": 1,
  "setupOptions": {
    "mapSizes": [
      { "id": "small", "name": "Small", "width": 16, "height": 12 },
      { "id": "medium", "name": "Medium", "width": 32, "height": 24 },
      { "id": "large", "name": "Large", "width": 64, "height": 48 }
    ],
    "allowSeed": true,
    "params": [
      {
        "id": "terrainDensity",
        "label": "Terrain Density",
        "type": "select",
        "defaultValue": "1",
        "options": [
          { "value": "0.65", "label": "Sparse" },
          { "value": "1", "label": "Standard" },
          { "value": "1.45", "label": "Rich" }
        ]
      }
    ]
  },
  "worldGenerator": [
    {
      "type": "clusters",
      "cell": "water",
      "clustersPer768": 9,
      "minClusters": 3,
      "minSize": 2,
      "maxSize": 5,
      "onlyOnEmpty": false,
      "densityParam": "terrainDensity"
    },
    {
      "type": "clusters",
      "cell": "mountain",
      "clustersPer768": 8,
      "minClusters": 3,
      "minSize": 2,
      "maxSize": 5,
      "onlyOnEmpty": true,
      "densityParam": "terrainDensity"
    },
    {
      "type": "clusters",
      "cell": "forest",
      "clustersPer768": 14,
      "minClusters": 5,
      "minSize": 3,
      "maxSize": 6,
      "onlyOnEmpty": true,
      "densityParam": "terrainDensity"
    }
  ],
  "resources": [
    {
      "id": "money",
      "name": "Money",
      "shortName": "Money",
      "description": "Currency from fed Houses.",
      "color": "#F59E0B",
      "kind": "unlimited",
      "initialValue": 35
    },
    {
      "id": "food",
      "name": "Food",
      "shortName": "Food",
      "description": "Farm +3, House −1.",
      "color": "#84CC16",
      "kind": "capped",
      "initialValue": 0,
      "initialMax": 100,
      "tags": ["storable"]
    },
    {
      "id": "wood",
      "name": "Wood",
      "shortName": "Wood",
      "description": "Sawmill +3.",
      "color": "#A16207",
      "kind": "capped",
      "initialValue": 10,
      "initialMax": 100,
      "tags": ["storable"]
    },
    {
      "id": "stone",
      "name": "Stone",
      "shortName": "Stone",
      "description": "Quarry +2.",
      "color": "#94A3B8",
      "kind": "capped",
      "initialValue": 0,
      "initialMax": 100,
      "tags": ["storable"]
    },
    {
      "id": "population",
      "name": "Population",
      "shortName": "Pop",
      "description": "Free / max workers.",
      "color": "#38BDF8",
      "kind": "capped",
      "initialValue": 1,
      "initialMax": 1
    }
  ],
  "supplies": [
    {
      "id": "moisture",
      "name": "Moisture",
      "description": "Irrigates Farms.",
      "color": "#0EA5E9",
      "maxExpected": 6,
      "decay": { "kind": "clear" }
    }
  ],
  "cellTypes": [
    {
      "id": "empty",
      "name": "Empty",
      "visual": { "color": "#111720", "icon": "empty" },
      "onClick": {
        "left": [
          {
            "do": [
              {
                "type": "openBuildMenu",
                "options": ["farm", "house", "warehouse"]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "water",
      "name": "Water",
      "shortRule": "+2 Moisture (r=2)",
      "visual": { "color": "#0EA5E9", "icon": "water" },
      "onCycle": [
        {
          "do": [
            {
              "type": "emitSupply",
              "id": "moisture",
              "amount": 2,
              "radius": 2,
              "neighborhood": "moore",
              "includeSelf": true
            }
          ]
        }
      ]
    },
    {
      "id": "forest",
      "name": "Forest",
      "visual": { "color": "#15803D", "icon": "forest" },
      "onClick": {
        "left": [
          {
            "do": [{ "type": "openBuildMenu", "options": ["sawmill"] }]
          }
        ]
      }
    },
    {
      "id": "mountain",
      "name": "Mountain",
      "visual": { "color": "#64748B", "icon": "mountain" },
      "onClick": {
        "left": [
          {
            "do": [{ "type": "openBuildMenu", "options": ["quarry"] }]
          }
        ]
      }
    },
    {
      "id": "farm",
      "name": "Farm",
      "shortRule": "+3 Food / cycle",
      "initialState": { "worker": 0, "idle": 0 },
      "buildCost": { "money": 5 },
      "visual": {
        "color": "#10B981",
        "icon": "farm",
        "border": "dashed",
        "dim": true,
        "rules": [
          {
            "when": [
              { "type": "supply", "id": "moisture", "op": "gte", "value": 1 },
              { "type": "state", "key": "worker", "op": "gte", "value": 1 }
            ],
            "border": "solid",
            "dim": false
          }
        ],
        "indicators": [
          {
            "kind": "dot",
            "position": "bottomRight",
            "when": [
              { "type": "state", "key": "worker", "op": "gte", "value": 1 }
            ],
            "color": "#10B981",
            "inactiveColor": "#8B98A9"
          }
        ]
      },
      "badges": [
        {
          "when": [
            { "type": "state", "key": "worker", "op": "gte", "value": 1 }
          ],
          "text": "W 1/1",
          "tone": "positive"
        },
        {
          "text": "W 0/1",
          "tone": "warning"
        }
      ],
      "onClick": {
        "left": [{ "do": [{ "type": "openPanel" }] }],
        "right": [{ "do": [{ "type": "openDemolishConfirm" }] }]
      },
      "onCycle": [
        {
          "when": [
            { "type": "supply", "id": "moisture", "op": "gte", "value": 1 },
            { "type": "state", "key": "worker", "op": "gte", "value": 1 }
          ],
          "do": [
            { "type": "addResource", "id": "food", "amount": 3 },
            { "type": "setState", "key": "idle", "value": 0 }
          ],
          "stop": true
        },
        {
          "when": [{ "type": "state", "key": "worker", "op": "lt", "value": 1 }],
          "do": [{ "type": "addState", "key": "idle", "amount": 1 }]
        },
        {
          "when": [
            { "type": "state", "key": "worker", "op": "lt", "value": 1 },
            { "type": "state", "key": "idle", "op": "gte", "value": 2 }
          ],
          "do": [
            {
              "type": "notify",
              "severity": "warning",
              "title": "Farm idle",
              "message": "No worker for {{state.idle}} cycles"
            }
          ]
        }
      ],
      "onDemolish": [
        {
          "do": [
            { "type": "addResource", "id": "money", "amount": 2 },
            {
              "type": "refundStateToResource",
              "stateKey": "worker",
              "resourceId": "population"
            }
          ]
        }
      ],
      "panel": [
        {
          "type": "stat",
          "label": "Moisture",
          "value": "{{supply.moisture}}",
          "tone": "positive",
          "toneWhen": [
            {
              "when": [
                { "type": "supply", "id": "moisture", "op": "lt", "value": 1 }
              ],
              "tone": "danger"
            }
          ]
        },
        {
          "type": "stat",
          "label": "Output",
          "value": "cycleOutput"
        },
        {
          "type": "stat",
          "label": "Idle",
          "value": "{{state.idle}} c.",
          "tone": "warning",
          "when": [
            { "type": "state", "key": "worker", "op": "lt", "value": 1 },
            { "type": "state", "key": "idle", "op": "gt", "value": 0 }
          ]
        },
        {
          "type": "transfer",
          "label": "Worker",
          "resource": "population",
          "stateKey": "worker",
          "min": 0,
          "max": 1,
          "assignLabel": "Assign Worker",
          "removeLabel": "Remove Worker",
          "resetKeys": ["idle"],
          "clearNotifications": true
        }
      ]
    },
    {
      "id": "sawmill",
      "name": "Sawmill",
      "shortRule": "+3 Wood / cycle",
      "initialState": { "worker": 0, "idle": 0 },
      "buildCost": { "money": 6 },
      "demolishTo": "forest",
      "visual": {
        "color": "#B45309",
        "icon": "sawmill",
        "substrateColor": "#15803D",
        "border": "dashed",
        "dim": true,
        "rules": [
          {
            "when": [
              { "type": "state", "key": "worker", "op": "gte", "value": 1 }
            ],
            "border": "solid",
            "dim": false
          }
        ],
        "indicators": [
          {
            "kind": "dot",
            "position": "bottomRight",
            "when": [
              { "type": "state", "key": "worker", "op": "gte", "value": 1 }
            ],
            "color": "#10B981",
            "inactiveColor": "#8B98A9"
          }
        ]
      },
      "badges": [
        {
          "when": [
            { "type": "state", "key": "worker", "op": "gte", "value": 1 }
          ],
          "text": "W 1/1",
          "tone": "positive"
        },
        {
          "text": "W 0/1",
          "tone": "warning"
        }
      ],
      "onClick": {
        "left": [{ "do": [{ "type": "openPanel" }] }],
        "right": [{ "do": [{ "type": "openDemolishConfirm" }] }]
      },
      "onCycle": [
        {
          "when": [
            { "type": "state", "key": "worker", "op": "gte", "value": 1 }
          ],
          "do": [
            { "type": "addResource", "id": "wood", "amount": 3 },
            { "type": "setState", "key": "idle", "value": 0 }
          ],
          "stop": true
        },
        {
          "do": [{ "type": "addState", "key": "idle", "amount": 1 }]
        },
        {
          "when": [
            { "type": "state", "key": "idle", "op": "gte", "value": 2 }
          ],
          "do": [
            {
              "type": "notify",
              "severity": "warning",
              "title": "Sawmill idle",
              "message": "No worker for {{state.idle}} cycles"
            }
          ]
        }
      ],
      "onDemolish": [
        {
          "do": [
            { "type": "addResource", "id": "money", "amount": 3 },
            {
              "type": "refundStateToResource",
              "stateKey": "worker",
              "resourceId": "population"
            }
          ]
        }
      ],
      "panel": [
        {
          "type": "stat",
          "label": "Output",
          "value": "cycleOutput"
        },
        {
          "type": "stat",
          "label": "Idle",
          "value": "{{state.idle}} c.",
          "tone": "warning",
          "when": [
            { "type": "state", "key": "worker", "op": "lt", "value": 1 },
            { "type": "state", "key": "idle", "op": "gt", "value": 0 }
          ]
        },
        {
          "type": "transfer",
          "label": "Worker",
          "resource": "population",
          "stateKey": "worker",
          "min": 0,
          "max": 1,
          "assignLabel": "Assign Worker",
          "removeLabel": "Remove Worker",
          "resetKeys": ["idle"],
          "clearNotifications": true
        }
      ]
    },
    {
      "id": "quarry",
      "name": "Quarry",
      "shortRule": "+2 Stone / cycle",
      "initialState": { "worker": 0, "idle": 0 },
      "buildCost": { "money": 8, "wood": 6 },
      "demolishTo": "mountain",
      "visual": {
        "color": "#CBD5E1",
        "icon": "quarry",
        "substrateColor": "#64748B",
        "border": "dashed",
        "dim": true,
        "rules": [
          {
            "when": [
              { "type": "state", "key": "worker", "op": "gte", "value": 1 }
            ],
            "border": "solid",
            "dim": false
          }
        ],
        "indicators": [
          {
            "kind": "dot",
            "position": "bottomRight",
            "when": [
              { "type": "state", "key": "worker", "op": "gte", "value": 1 }
            ],
            "color": "#10B981",
            "inactiveColor": "#8B98A9"
          }
        ]
      },
      "badges": [
        {
          "when": [
            { "type": "state", "key": "worker", "op": "gte", "value": 1 }
          ],
          "text": "W 1/1",
          "tone": "positive"
        },
        {
          "text": "W 0/1",
          "tone": "warning"
        }
      ],
      "onClick": {
        "left": [{ "do": [{ "type": "openPanel" }] }],
        "right": [{ "do": [{ "type": "openDemolishConfirm" }] }]
      },
      "onCycle": [
        {
          "when": [
            { "type": "state", "key": "worker", "op": "gte", "value": 1 }
          ],
          "do": [
            { "type": "addResource", "id": "stone", "amount": 2 },
            { "type": "setState", "key": "idle", "value": 0 }
          ],
          "stop": true
        },
        {
          "do": [{ "type": "addState", "key": "idle", "amount": 1 }]
        },
        {
          "when": [
            { "type": "state", "key": "idle", "op": "gte", "value": 2 }
          ],
          "do": [
            {
              "type": "notify",
              "severity": "warning",
              "title": "Quarry idle",
              "message": "No worker for {{state.idle}} cycles"
            }
          ]
        }
      ],
      "onDemolish": [
        {
          "do": [
            { "type": "addResource", "id": "money", "amount": 4 },
            { "type": "addResource", "id": "wood", "amount": 3 },
            {
              "type": "refundStateToResource",
              "stateKey": "worker",
              "resourceId": "population"
            }
          ]
        }
      ],
      "panel": [
        {
          "type": "stat",
          "label": "Output",
          "value": "cycleOutput"
        },
        {
          "type": "stat",
          "label": "Idle",
          "value": "{{state.idle}} c.",
          "tone": "warning",
          "when": [
            { "type": "state", "key": "worker", "op": "lt", "value": 1 },
            { "type": "state", "key": "idle", "op": "gt", "value": 0 }
          ]
        },
        {
          "type": "transfer",
          "label": "Worker",
          "resource": "population",
          "stateKey": "worker",
          "min": 0,
          "max": 1,
          "assignLabel": "Assign Worker",
          "removeLabel": "Remove Worker",
          "resetKeys": ["idle"],
          "clearNotifications": true
        }
      ]
    },
    {
      "id": "house",
      "name": "House",
      "shortRule": "−1 Food → +1 Money",
      "initialState": { "hunger": 0 },
      "priorityByState": "hunger",
      "buildCost": { "money": 6, "wood": 4 },
      "modifiers": [
        { "type": "capBonus", "resource": "population", "amount": 1 }
      ],
      "visual": {
        "color": "#CBD5E1",
        "icon": "house",
        "border": "solid",
        "rules": [
          {
            "when": [
              { "type": "state", "key": "hunger", "op": "gte", "value": 3 }
            ],
            "color": "#F43F5E",
            "border": "dashed"
          },
          {
            "when": [
              { "type": "state", "key": "hunger", "op": "gte", "value": 1 }
            ],
            "color": "#F59E0B",
            "border": "solid"
          }
        ]
      },
      "badges": [
        {
          "when": [
            { "type": "state", "key": "hunger", "op": "gte", "value": 3 }
          ],
          "text": "Hunger {{state.hunger}}/3",
          "tone": "danger"
        },
        {
          "when": [
            { "type": "state", "key": "hunger", "op": "gte", "value": 1 }
          ],
          "text": "Hunger {{state.hunger}}/3",
          "tone": "warning"
        }
      ],
      "onClick": {
        "right": [{ "do": [{ "type": "openDemolishConfirm" }] }]
      },
      "onBuild": [
        {
          "do": [{ "type": "addResource", "id": "population", "amount": 1 }]
        }
      ],
      "onCycle": [
        {
          "when": [
            { "type": "resource", "id": "food", "op": "gte", "value": 1 }
          ],
          "do": [
            { "type": "consumeResource", "id": "food", "amount": 1 },
            { "type": "addResource", "id": "money", "amount": 1 },
            { "type": "setState", "key": "hunger", "value": 0 }
          ],
          "stop": true
        },
        {
          "when": [
            { "type": "state", "key": "hunger", "op": "gte", "value": 3 }
          ],
          "do": [{ "type": "transform", "to": "empty" }],
          "label": "Collapses next cycle",
          "tone": "danger",
          "stop": true
        },
        {
          "do": [{ "type": "addState", "key": "hunger", "amount": 1 }],
          "label": "No Food ({{state.hunger}}/3)",
          "tone": "danger"
        },
        {
          "when": [
            { "type": "state", "key": "hunger", "op": "gte", "value": 3 }
          ],
          "do": [
            {
              "type": "notify",
              "severity": "danger",
              "title": "Starving ({{state.hunger}}/3)",
              "message": "No Food — collapses next cycle"
            }
          ]
        }
      ],
      "onDemolish": [
        {
          "do": [
            { "type": "addResource", "id": "money", "amount": 3 },
            { "type": "addResource", "id": "wood", "amount": 2 },
            {
              "type": "reclaimResource",
              "resourceId": "population",
              "amount": 1,
              "fallbackStateKey": "worker"
            }
          ]
        }
      ],
      "onLost": [
        {
          "do": [
            {
              "type": "reclaimResource",
              "resourceId": "population",
              "amount": 1,
              "fallbackStateKey": "worker"
            }
          ]
        }
      ]
    },
    {
      "id": "warehouse",
      "name": "Warehouse",
      "shortRule": "+100 resource cap",
      "initialState": { "storageResource": "" },
      "buildCost": { "money": 10, "wood": 8, "stone": 6 },
      "modifiers": [
        {
          "type": "capBonus",
          "resourceFromState": "storageResource",
          "amount": 100
        }
      ],
      "visual": {
        "color": "#818CF8",
        "icon": "warehouse",
        "border": "dashed",
        "dim": true,
        "rules": [
          {
            "when": [
              {
                "type": "state",
                "key": "storageResource",
                "op": "neq",
                "value": ""
              }
            ],
            "border": "solid",
            "dim": false
          }
        ],
        "indicators": [
          {
            "kind": "bar",
            "colorFromResourceState": "storageResource",
            "when": [
              {
                "type": "state",
                "key": "storageResource",
                "op": "neq",
                "value": ""
              }
            ]
          }
        ]
      },
      "badges": [
        {
          "when": [
            {
              "type": "state",
              "key": "storageResource",
              "op": "neq",
              "value": ""
            }
          ],
          "text": "{{resourceName:storageResource}} +100",
          "tone": "positive"
        },
        {
          "text": "Unset",
          "tone": "warning"
        }
      ],
      "onClick": {
        "left": [{ "do": [{ "type": "openPanel" }] }],
        "right": [{ "do": [{ "type": "openDemolishConfirm" }] }]
      },
      "onDemolish": [
        {
          "do": [
            { "type": "addResource", "id": "money", "amount": 5 },
            { "type": "addResource", "id": "wood", "amount": 4 },
            { "type": "addResource", "id": "stone", "amount": 3 }
          ]
        }
      ],
      "panel": [
        {
          "type": "resourceSelect",
          "label": "Cap Bonus",
          "bonusText": "+100",
          "stateKey": "storageResource",
          "kind": "capped",
          "tag": "storable"
        }
      ]
    }
  ]
}
